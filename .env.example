# ==============================================================================
# NETRA - Environment Configuration Template
# ==============================================================================

# Backend API Configuration
NETRA_HOST=0.0.0.0
NETRA_PORT=8000
NETRA_ENV=development
NETRA_LOG_LEVEL=INFO

# Security & CORS
NETRA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NETRA_API_PREFIX=/api/v1

# Storage & Model Paths
NETRA_MODEL_PATH=models/best_model_aptos_ddr.pth
NETRA_FALLBACK_MODEL_PATH=models/best_model.pth
NETRA_CASES_DIR=outputs/cases
NETRA_PATIENTS_DIR=outputs/patients
NETRA_EXPLAINABILITY_DIR=outputs/explainability

# Clinical Quality Assessment Configurable Thresholds
NETRA_FOCUS_THRESHOLD=80.0
NETRA_MIN_FOV_RATIO=0.15
NETRA_MIN_GREEN_INTENSITY=40.0
NETRA_MAX_GREEN_INTENSITY=210.0
NETRA_MAX_PIXEL_SATURATION_PERCENT=5.0
